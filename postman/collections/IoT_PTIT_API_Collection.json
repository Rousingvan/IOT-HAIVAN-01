          "name": "01. Lấy danh sách thiết bị & Trạng thái (Device List)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/devices",
              "host": ["{{baseUrl}}"],
              "path": ["devices"]
            }
          }
        },
        {
          "name": "02. Bật Đèn 1 (LAMP_01 ON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/P201_LAMP_01/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "P201_LAMP_01", "toggle"]
            }
          }
        },
        {
          "name": "03. Tắt Đèn 1 (LAMP_01 OFF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"OFF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/P201_LAMP_01/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "P201_LAMP_01", "toggle"]
            }
          }
        },
        {
          "name": "04. Bật Đèn 2 (LAMP_02 ON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/P201_LAMP_02/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "P201_LAMP_02", "toggle"]
            }
          }
        },
        {
          "name": "05. Tắt Đèn 2 (LAMP_02 OFF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"OFF\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/devices/P201_LAMP_02/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["devices", "P201_LAMP_02", "toggle"]
            }
          }
        }
      ]
    },
    {
      "name": "05_Action_History",
      "item": [
        {
          "name": "01. Tra cứu Lịch sử Điều khiển Thiết bị (Phân trang)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/action-history?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["action-history"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "02. Lọc Lịch sử theo Đèn 1 (Filter by LAMP_01)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/action-history?deviceCode=LAMP_01&page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["action-history"],
              "query": [
                {
                  "key": "deviceCode",
                  "value": "LAMP_01"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
